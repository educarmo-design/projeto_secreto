<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect: só as permissões dos HealthDataType que
         HealthSyncService.todosOsTipos realmente pede — nunca o catálogo
         inteiro do Health Connect, que o plugin `health` só usa como
         exemplo. Só READ, nunca WRITE: _lerComPermissao pede
         HealthDataAccess.READ (corrigido nesta tarefa — antes pedia
         READ_WRITE por engano) porque HealthSyncService nunca chama nenhum
         método de escrita do plugin; o app só lê do Health Connect e grava
         seus próprios dados no Supabase, nunca de volta no health store do
         SO. Pedir WRITE que nunca é usado seria permissão a mais do que o
         app precisa. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
    <uses-permission android:name="android.permission.health.READ_BODY_FAT"/>
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE"/>
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE"/>
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION"/>
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <!-- N17/N18: RESTING_HEART_RATE e LEAN_BODY_MASS somam-se a
         HealthSyncService.todosOsTipos nesta tarefa (ver RELATÓRIO) — FC
         genérica (READ_HEART_RATE, já acima) e FC de repouso passam a ser
         sinais distintos; massa magra não era lida antes. -->
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS"/>

    <!-- fc_maxima/balança (RELATÓRIO 20260811130000) — BODY_WATER_MASS e
         BODY_MASS_INDEX somaram-se a HealthSyncService.todosOsTipos, mas
         faltaram aqui (BUG desta tarefa — "permissão negada" mesmo com tudo
         concedido, ver RELATÓRIO 20260810_0005). Achado ao investigar: a
         permissão que falta para BODY_MASS_INDEX NÃO é
         "READ_BODY_MASS_INDEX" — essa permissão não existe. O Health
         Connect não tem um registro nativo de IMC; o pacote `health`, no
         Android, substitui BODY_MASS_INDEX por WEIGHT+HEIGHT por baixo dos
         panos (health_plugin.dart, _handleBMI/_computeAndroidBMI) e calcula
         o IMC ele mesmo a partir da ALTURA já registrada no Health Connect
         (não a de perfis_usuarios.altura_cm, que só entra como fallback em
         HealthSyncService._aplicarInferenciasCruzadas quando o Health
         Connect não devolve nada). READ_WEIGHT já existia acima; faltava
         READ_HEIGHT — confirmado lendo o bytecode de
         androidx.health.connect:connect-client (HealthPermission), não
         adivinhado. Como hasPermissions()/requestAuthorization() pedem
         SEMPRE o lote inteiro de tipos de uma vez, uma permissão faltando
         no Manifest pode derrubar/negar a autorização do lote inteiro —
         explica o "negada mesmo tendo concedido tudo" do teste físico. -->
    <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS"/>
    <uses-permission android:name="android.permission.health.READ_HEIGHT"/>

    <!-- CAUSA RAIZ do bug "só 2 dias na Carga Inicial" (N18, ver RELATÓRIO
         20260809): por padrão, o Health Connect só deixa um app ler dados
         de ATÉ 30 dias A PARTIR DO MOMENTO em que a permissão normal foi
         concedida — não os 30 dias anteriores a "agora". Sem esta permissão
         extra, carregarHistoricoInicial(dias: 30) pedia a janela certa, mas
         o Health Connect simplesmente não tinha nada histórico para
         devolver além do que foi gravado desde a concessão (daí "ontem e
         hoje": exatamente a janela entre o teste de conexão e o teste
         seguinte). READ_HEALTH_DATA_HISTORY é uma permissão SEPARADA das
         READ_* normais acima — precisa de um diálogo próprio
         (Health.requestHealthDataHistoryAuthorization(), chamado em
         HealthSyncService.carregarHistoricoInicial). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY"/>

    <!-- BackgroundSyncManager roda sync_diario_wearables via WorkManager de
         madrugada (Wi-Fi + carregando) chamando
         HealthSyncService.sincronizarDeltaDiario — sem esta permissão o
         Health Connect recusa a leitura fora do app em primeiro plano. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"/>

    <application
        android:label="atleta_gamificacao"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Exigido pelo Health Connect (Android 14+): mostra a tela de
                 motivo/racional do app para pedir acesso a dados de saúde. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Deep link do Supabase Auth (OAuth Google/Apple e link de
                 "definir nova senha" do e-mail de recuperação) —
                 AppConfig.oauthRedirectUrl aponta pra cá
                 (io.supabase.atletaapp://login-callback), mas até
                 agora nada no Android sabia entregar essa URI ao app: o
                 pacote supabase_flutter já intercepta e traduz sozinho
                 (authFlowType PKCE, padrão do pacote) assim que o SO abre a
                 Activity — só faltava este intent-filter dizendo ao Android
                 que esta Activity responde por esse esquema. android:host
                 tem que bater exatamente com o path depois de "://" na URL
                 configurada. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="io.supabase.atletaapp"
                    android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- Exigido pelo Health Connect: a "Política de Privacidade de Uso
             de Permissão" do sistema abre esta activity-alias quando o
             usuário revisa, em Configurações do Android, quais apps leem
             seus dados de saúde. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- HealthSyncService.instalarHealthConnect()/isHealthConnectAvailable()
             precisam enxergar o pacote do app Health Connect. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
