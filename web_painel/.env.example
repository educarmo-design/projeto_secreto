# Mesmo projeto Supabase do app mobile — a mesma anon key pública, nunca
# uma service role key (o painel roda inteiramente no navegador do
# profissional; qualquer chave elevada aqui seria extraível por qualquer
# um que abrisse o DevTools).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Function (Server-to-Server) que despacha planos de treino para a
# Garmin Training API — supabase/functions/garmin-gateway/, chamada por
# src/features/prescriptions/services/garminApi.ts.
VITE_GARMIN_DISPATCH_ENDPOINT=https://your-project.supabase.co/functions/v1/garmin-gateway
