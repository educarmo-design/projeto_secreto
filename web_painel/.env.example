# web_painel/.env.example — modelo de `.env` (que também é versionado).
#
# O `.env` real está no repositório (decisão 92 / N44) e contém só valores
# públicos; este arquivo documenta cada variável. Segredos NÃO vivem em
# nenhum dos dois: ver `.env.local.example`.

# URL do projeto — só a ORIGEM, sem `/rest/v1/` (o supabase-js acrescenta
# sozinho; com o sufixo a URL fica duplicada e o painel quebra).
VITE_SUPABASE_URL=https://xtipphglpqqrjguxcajn.supabase.co

# Chave publicável (Dashboard > Settings > API Keys > "Publishable key").
# Pública por desenho: vai no bundle do navegador; a proteção é a RLS.
# NUNCA colar aqui uma `sb_secret_…` nem a service role — qualquer chave
# elevada neste arquivo seria extraível por quem abrisse o DevTools.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# Edge Function (Server-to-Server) que despacha planos de treino para a
# Garmin Training API — supabase/functions/garmin-gateway/, chamada por
# src/features/prescriptions/services/garminApi.ts. (Placeholder de
# propósito: a função não está deployada — decisão do fundador, 17/set.)
VITE_GARMIN_DISPATCH_ENDPOINT=https://your-project.supabase.co/functions/v1/garmin-gateway

# Edge Function que cria/aceita/encerra vínculos profissional-paciente
# (Adendo v4, Parte F) — supabase/functions/manage-professional-link/,
# chamada por src/features/patients/services/vinculosApi.ts (botão
# "Convidar Paciente" em PatientList.tsx).
VITE_MANAGE_PROFESSIONAL_LINK_ENDPOINT=https://xtipphglpqqrjguxcajn.supabase.co/functions/v1/manage-professional-link

# RELATÓRIO 20260901_0001 (R15) — SUPABASE_SECRET_KEY e GEMINI_API_KEY
# NÃO vivem aqui; moram só em `.env.local` (nunca commitado — ver
# `.env.local.example`).
