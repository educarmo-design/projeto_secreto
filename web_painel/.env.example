# Edge Function (Server-to-Server) que despacha planos de treino para a
# Garmin Training API — supabase/functions/garmin-gateway/, chamada por
# src/features/prescriptions/services/garminApi.ts.
VITE_GARMIN_DISPATCH_ENDPOINT=https://your-project.supabase.co/functions/v1/garmin-gateway

# Edge Function que cria/aceita/encerra vínculos profissional-paciente
# (Adendo v4, Parte F) — supabase/functions/manage-professional-link/,
# chamada por src/features/patients/services/vinculosApi.ts (botão
# "Convidar Paciente" em PatientList.tsx).
VITE_MANAGE_PROFESSIONAL_LINK_ENDPOINT=https://your-project.supabase.co/functions/v1/manage-professional-link

# Usada SÓ por scripts/seed_cloud.ts (rodado localmente com `npm run
# seed:cloud`, nunca pelo app no navegador) para chamar a Admin API do
# GoTrue (auth.admin.createUser) e semear os 10 pacientes fictícios no
# projeto Supabase Cloud — pegue em Project Settings > API no painel do
# Supabase. NUNCA prefixe com VITE_ (isso a exporia no bundle do navegador)
# e nunca commite o valor real; adicione-a só no seu `.env` local
# (já ignorado pelo git).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Usada SÓ por scripts/seed_food_embeddings.ts (rodado localmente com `npm
# run seed:food-embeddings`, nunca pelo app no navegador) para chamar
# text-embedding-004 do Gemini e popular alimentos_referencia.embedding —
# a MESMA chave já configurada como secret da Edge Function
# extract-metric-photo (Google AI Studio). NUNCA prefixe com VITE_ e nunca
# commite o valor real.
GEMINI_API_KEY=your-gemini-api-key-here
