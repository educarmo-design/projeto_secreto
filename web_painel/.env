# web_painel/.env — VERSIONADO (decisão 92 / N44). Só valores PÚBLICOS.
#
# Este arquivo vai para o repositório de propósito: um clone novo precisa
# subir sem edição manual. Por isso NADA aqui pode ser segredo:
#   - a URL do projeto e os endpoints das Edge Functions são públicos;
#   - a chave publicável (`sb_publishable_…`) é pública POR DESENHO — vai
#     dentro do bundle que qualquer visitante baixa. Quem protege os dados é
#     a RLS no Postgres, nunca o sigilo dessa chave.
# Chaves privilegiadas (`sb_secret_…`, service role, Gemini) NUNCA entram
# aqui: moram só em `.env.local` (não versionado) — ver `.env.local.example`.
# O CI recusa o PR se uma chave secreta aparecer em qualquer arquivo versionado.

# URL do projeto — só a ORIGEM, sem `/rest/v1/` (o supabase-js acrescenta sozinho).
VITE_SUPABASE_URL=https://xtipphglpqqrjguxcajn.supabase.co

# Chave publicável do projeto (Dashboard > Settings > API Keys > "Publishable key",
# formato `sb_publishable_…`). Cole aqui no Passo 1 do N44 e faça commit.
# Enquanto estiver vazia, o painel usa a chave legada `VITE_SUPABASE_ANON_KEY`
# do seu `.env.local` (fallback de transição).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Edge Function (Server-to-Server) que despacha planos de treino para a
# Garmin Training API — supabase/functions/garmin-gateway/, chamada por
# src/features/prescriptions/services/garminApi.ts.
# NÃO CORRIGIDO DE PROPÓSITO (decisão do fundador em 17/set): a função não
# está deployada e depende de credenciais Garmin que ainda não existem.
VITE_GARMIN_DISPATCH_ENDPOINT=https://your-project.supabase.co/functions/v1/garmin-gateway

# Edge Function que cria/aceita/encerra vínculos profissional-paciente
# (Adendo v4, Parte F) — supabase/functions/manage-professional-link/,
# chamada por src/features/patients/services/vinculosApi.ts (botão
# "Convidar Paciente" em PatientList.tsx). Esta é a correção que antes só
# existia na máquina do fundador (relatório 20260917_0003).
VITE_MANAGE_PROFESSIONAL_LINK_ENDPOINT=https://xtipphglpqqrjguxcajn.supabase.co/functions/v1/manage-professional-link
